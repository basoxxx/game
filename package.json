{
  "name": "apex-dynasty",
  "productName": "Apex Dynasty",
  "version": "4.0.1",
  "description": "Apex Dynasty - Motorsport Manager multi-categoria (Formula, Rally, Endurance)",
  "author": "Apex Dynasty Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "build:site": "vite build && node scripts-build-site.mjs"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/titillium-web": "^5.3.0",
    "three": "^0.170.0"
  },
  "build": {
    "appId": "com.apexdynasty.game",
    "productName": "Apex Dynasty",
    "copyright": "Apex Dynasty – gioco di fantasia",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "artifactName": "ApexDynasty-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.simulation-games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Apex Dynasty ${version}"
    },
    "afterPack": "build/afterPack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Apex Dynasty",
      "artifactName": "ApexDynasty-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "ApexDynasty-${version}-Portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/basoxxx/game.git"
  },
  "homepage": "https://basoxxx.github.io/game/"
}
